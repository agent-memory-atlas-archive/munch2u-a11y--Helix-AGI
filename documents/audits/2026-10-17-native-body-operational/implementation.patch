+    const lines = [];
+    if (state.foreground && state.foreground.status === 'failed') {
+      lines.push(`Language is unavailable: ${state.foreground.error}. The body is still receptive.`);
+    }
+    for (const job of state.jobs || []) {
+      lines.push(`${job.status}: ${job.message}`);
+      for (const result of job.receipts || []) {
+        const output = (result.receipt || {}).output || {};
+        lines.push(`${result.action}: /${output.path || output.position || ''}`);
+        if (typeof output.content === 'string') lines.push(output.content);
+        if (typeof output.stdout === 'string') lines.push(output.stdout);
+        if (typeof output.stderr === 'string' && output.stderr) lines.push(output.stderr);
+        if (output.return_code !== undefined) lines.push(`Exit status: ${output.return_code}`);
+      }
+      if (job.error) lines.push(job.error);
+    }
+    document.getElementById('body-observations').textContent = lines.join('\n\n') || 'Observing surroundings; no action requested.';
+  }).catch(() => {
+    document.getElementById('body-observations').textContent = 'Body status is unavailable.';
+  });
+}
+setInterval(pollBodyObservations, 1000);
+pollBodyObservations();
+
 setInterval(pollChatOutbound, 3000);
 
